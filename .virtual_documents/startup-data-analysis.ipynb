import numpy as np
import pandas as pd


funding_2025 = pd.read_csv("indian_startup_funding_2020_2025_sample.csv")
funding_2015 = pd.read_csv("startup_funding.csv")


funding_2025.head()


funding_2015.tail()


funding_2015 = funding_2015.drop(['Sr No', 'Remarks'], axis=1)


funding_2015.head()


funding_2025.head()


funding_2015.rename(
    columns={
        "Date dd/mm/yyyy":'Date',
        'Startup Name':'Startup',
        'Industry Vertical':'Industry',
        'City  Location':'City',
        'Investors Name':'Investors',
        'InvestmentType':'Investment Type'},
    inplace=True)


funding_2025.rename(columns = {'InvestmentAmount_USD':'Amount in USD', 'InvestmentType':'Investment Type'}, inplace=True)


funding_2015.columns


funding_2025.columns


funding_2025['Date'] = pd.to_datetime(
    funding_2025['Date'],
    format='%d-%m-%Y'
)

funding_2025.sort_values('Date', ascending=False, inplace=True)


funding_2025['Date'] = funding_2025['Date'].dt.strftime('%d/%m/%Y')


funding = pd.concat([funding_2025, funding_2015])


